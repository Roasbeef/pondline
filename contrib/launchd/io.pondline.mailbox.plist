<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.pondline.mailbox</string>

  <key>ProgramArguments</key>
  <array>
    <!-- Replace /Users/YOU with your home directory after `make install` -->
    <string>/Users/YOU/.local/bin/pondline-mailbox</string>
    <string>serve</string>
    <string>--db</string>
    <string>/Users/YOU/.pondline-mailbox/mailbox.db</string>
    <string>--tor-state</string>
    <!-- Keep under ~80 chars so Arti's connect.sock fits macOS AF_UNIX sun_path -->
    <string>/Users/YOU/.pondline-mailbox/tor</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PONDLINE_LOG_LEVEL</key>
    <string>info</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>SoftResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>16384</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/YOU/.pondline-mailbox/stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/YOU/.pondline-mailbox/stderr.log</string>
</dict>
</plist>
