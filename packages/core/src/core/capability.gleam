//// Bearer capabilities for mailbox operations, typed by the authority
//// they carry (spec §3.2).
////
//// A queue has separate credentials for separate operations, and the
//// separation is only real if one cannot be presented where another is
//// expected. A phantom parameter makes that a type error: an
//// `Capability(Append)` handed to a peer in an invitation can never be
//// passed to `Fetch`, which takes a `Capability(Read)`.
////
//// Capabilities are generated by the queue's creator from the injected
//// CSPRNG and registered with the mailbox at `CreateQueue`, so creation is
//// idempotent without a server-side allocation round trip. Each is
//// thirty-two random bytes held as a `Secret`, because a capability is
//// authority: it must never be logged, and the mailbox stores only what it
//// needs to compare.

import core/secret.{type Secret}
import gleam/bit_array

/// The size of every capability, in bytes.
pub const capability_bytes = 32

/// A bearer credential granting `authority` over one queue, or over a
/// provisioning allowance.
pub opaque type Capability(authority) {
  Capability(secret: Secret)
}

/// Submit bounded ciphertext to one queue. Handed to the peer.
pub type Append

/// Fetch and acknowledge one queue's envelopes. Kept by the recipient.
pub type Read

/// Delete or reconfigure one queue. Kept by the recipient.
pub type Admin

/// Create queues within an allowance at one mailbox. Issued by the
/// mailbox operator to a daemon.
pub type Provision

/// Builds a capability from exactly `capability_bytes` bytes.
///
/// ## Examples
///
/// ```gleam
/// capability.from_bytes(<<0:256>>)
/// // -> Ok(_)
/// capability.from_bytes(<<0:8>>)
/// // -> Error(Nil)
/// ```
pub fn from_bytes(bytes: BitArray) -> Result(Capability(authority), Nil) {
  case bit_array.byte_size(bytes) == capability_bytes {
    True -> Ok(Capability(secret: secret.new(bytes)))
    False -> Error(Nil)
  }
}

/// The capability's bytes, for the wire encoder and the mailbox's
/// comparison. Every caller is handling authority.
///
/// ## Examples
///
/// ```gleam
/// let assert Ok(append) = capability.from_bytes(<<9:256>>)
/// capability.expose(append)
/// // -> <<9:256>>
/// ```
pub fn expose(capability: Capability(authority)) -> BitArray {
  secret.expose(capability.secret)
}
