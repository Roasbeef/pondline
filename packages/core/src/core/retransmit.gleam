//// End-to-end retransmission: when a sender sends a stored message's
//// committed ciphertext again, and when it gives up
//// (`docs/adr/006-end-to-end-retransmit.md`, spec §7.3, §8.2).
////
//// A mailbox's `Appended` is evidence that it accepted an envelope, not
//// that it will hand the envelope over (spec §6.4). A mailbox that corrupts
//// or loses a stored envelope, or one the receiver could not fetch before
//// the mailbox discarded it, loses the message for good if the sender never
//// sends again: the scheduler stops at `Appended`, and the receiver drops
//// and acknowledges what it cannot decrypt. The peer's receipt is the only
//// evidence of arrival, so a stored message whose receipt does not come
//// within a window is sent again.
////
//// ## Same bytes, new envelope
////
//// A retransmit is the *same committed padded ciphertext* under a *new
//// envelope identifier*. Never re-encrypted: encryption is deterministic in
//// the ratchet state, so re-encrypting from an old state would seal two
//// messages under one key, and encrypting from the current state would make
//// a second message the receiver delivers twice. And a new identifier,
//// because the mailbox keeps a tombstone for every acknowledged envelope and
//// would answer the old identifier from it without storing anything. The
//// shell copies the bytes from the committed row it is replacing, inside one
//// transaction, so a retransmit cannot carry anything the store did not
//// already hold, and "no send before commit" holds as it does for every row.
////
//// ## When, how often, and what
////
//// `due_at` is the whole schedule. A row the mailbox stored at `stored_at`
//// after `retransmits` earlier copies is due again `receipt_window_seconds`
//// doubled `retransmits` times later, so a slow receiver is not flooded. No
//// copy is sent past the message's own expiry, which is also its retention
//// deadline, and none after `max_retransmits` copies. `retransmit` is the
//// transition the shell runs on a due row, against the relationship as it
//// is now: application messages are sent again only while the relationship
//// is `Active`, the one phase that can still receive the receipt that ends
//// the schedule; `Accept`, `Reject` and `Close` are sent again whatever the
//// phase, since they earn no receipt and the session that sealed them may
//// already be gone. Receipts are never sent again (they request no receipt,
//// so nothing would stop the schedule; a lost receipt is regenerated by the
//// receiver when the message's retransmit arrives), and neither is the
//// handshake. `is_retransmitted` is that rule.

import core/crypto/suite.{type Suite}
import core/field
import core/id.{type Envelope, type Id}
import core/limits
import core/plan.{type OutboundKind}
import core/relationship.{type Relationship}
import core/time.{type Instant}
import gleam/int
import gleam/option.{type Option, None, Some}
import gleam/result

/// A committed outbox row the mailbox stored and whose message has no peer
/// receipt yet, as the shell reads it back.
pub type Unreceipted {
  Unreceipted(
    /// The envelope it was stored under; the retransmit replaces it.
    envelope: Id(Envelope),
    /// What it carries.
    kind: OutboundKind,
    /// Its retention deadline, which for a message is the message's own
    /// expiry.
    deadline: Instant,
    /// How many copies were sent before this one: zero for the row the
    /// message was first committed in.
    retransmits: Int,
  )
}

/// A retransmit to commit: a new outbox row under `envelope`, holding the
/// bytes, route, deadline and kind of the row `replaces`, which is never
/// sent again.
pub type Retransmission {
  Retransmission(
    /// The stored row whose bytes are copied.
    replaces: Id(Envelope),
    /// The fresh identifier the copy is stored under.
    envelope: Id(Envelope),
    /// How many copies were sent before the new one: one more than the row
    /// it replaces.
    retransmits: Int,
  )
}

/// Why a stored row is not sent again. Every variant but `NoRandomness`
/// is final: the shell stops considering the row.
pub type Stop {
  /// A receipt or the handshake, which are never sent again.
  NotRetransmitted

  /// An application message on a relationship that is no longer `Active`:
  /// no receipt can reach it, so nothing would end the schedule.
  NotActive

  /// `max_retransmits` copies were already sent.
  Exhausted

  /// The message expired; the mailbox would refuse it and the receiver
  /// would not act on it.
  Expired

  /// The injected randomness source returned the wrong number of bytes.
  /// Transient: the row stays due.
  NoRandomness
}

/// When a row the mailbox stored at `stored_at` is due to be sent again, or
/// `None` when it never will be: a kind that is never retransmitted,
/// `max_retransmits` copies already sent, or a due instant past `deadline`.
/// `window` is the first wait, `limits.receipt_window_seconds` in
/// production; each later copy waits twice as long as the one before.
///
/// ## Examples
///
/// ```gleam
/// retransmit.due_at(3600, plan.ApplicationOut(m), Instant(0), 2, Instant(99_999))
/// // -> Some(Instant(14_400))
///
/// retransmit.due_at(3600, plan.ReceiptOut(m), Instant(0), 0, Instant(99_999))
/// // -> None
/// ```
pub fn due_at(
  window: Int,
  kind: OutboundKind,
  stored_at: Instant,
  retransmits: Int,
  deadline: Instant,
) -> Option(Instant) {
  let due = time.add(stored_at, window * int.bitwise_shift_left(1, retransmits))

  // A copy that could not go out before the deadline, or one past the
  // bound, is never scheduled; the rest wait their doubled window.
  case
    is_retransmitted(kind)
    && retransmits < limits.max_retransmits
    && !time.is_past(due, deadline)
  {
    True -> Some(due)
    False -> None
  }
}

/// Sends a due row again: a fresh envelope identifier for a copy of its
/// bytes. The caller has checked the row is due (`due_at`); this checks
/// what may have changed since it was scheduled, the relationship's phase
/// and the clock, and refuses with a `Stop` that changes nothing.
///
/// ## Examples
///
/// ```gleam
/// retransmit.retransmit(suite, active, stored, now)
/// // -> Ok(Retransmission(replaces: stored.envelope, envelope: _, retransmits: 1))
/// ```
pub fn retransmit(
  suite: Suite,
  relationship: Relationship,
  row: Unreceipted,
  now: Instant,
) -> Result(Retransmission, Stop) {
  use Nil <- result.try(check_kind(row.kind, relationship))
  use Nil <- result.try(check_bounds(row, now))
  use envelope <- result.try(
    field.fresh_id(suite)
    |> result.replace_error(NoRandomness),
  )

  Ok(Retransmission(
    replaces: row.envelope,
    envelope:,
    retransmits: row.retransmits + 1,
  ))
}

/// Whether a kind is ever sent again.
fn is_retransmitted(kind: OutboundKind) -> Bool {
  case kind {
    plan.ApplicationOut(_) | plan.ControlOut(_) -> True
    plan.ReceiptOut(_) | plan.Handshake -> False
  }
}

/// Refuses a kind that is never sent again, and an application message
/// whose relationship can no longer receive its receipt.
fn check_kind(
  kind: OutboundKind,
  relationship: Relationship,
) -> Result(Nil, Stop) {
  case kind, relationship.phase {
    plan.ControlOut(_), _ -> Ok(Nil)

    plan.ApplicationOut(_), relationship.Active(_) -> Ok(Nil)

    plan.ApplicationOut(_), relationship.Joining(..)
    | plan.ApplicationOut(_), relationship.AwaitingAccept(_)
    | plan.ApplicationOut(_), relationship.PendingApproval(_)
    | plan.ApplicationOut(_), relationship.Closed(_)
    -> Error(NotActive)

    plan.ReceiptOut(_), _ | plan.Handshake, _ -> Error(NotRetransmitted)
  }
}

/// Refuses a row past the bound or the message's expiry.
fn check_bounds(row: Unreceipted, now: Instant) -> Result(Nil, Stop) {
  case
    row.retransmits >= limits.max_retransmits,
    time.is_past(now, row.deadline)
  {
    True, _ -> Error(Exhausted)
    False, True -> Error(Expired)
    False, False -> Ok(Nil)
  }
}
